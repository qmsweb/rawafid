---
# خريطة الموقع ديناميكية: تُبنى تلقائياً عند النشر عبر Jekyll
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset
      xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
      xmlns:news="http://www.google.com/schemas/sitemap-news/0.9"
      xmlns:xhtml="http://www.w3.org/1999/xhtml"
      xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
      xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">

<!-- ===== الصفحات الرئيسية ===== -->
<url>
  <loc>{{ site.url }}/</loc>
  <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  <changefreq>weekly</changefreq>
  <priority>1.00</priority>
</url>
<url>
  <loc>{{ site.url }}/tools</loc>
  <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  <changefreq>weekly</changefreq>
  <priority>0.80</priority>
</url>
<url>
  <loc>{{ site.url }}/blog</loc>
  <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  <changefreq>weekly</changefreq>
  <priority>0.80</priority>
</url>
<url>
  <loc>{{ site.url }}/about</loc>
  <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  <changefreq>monthly</changefreq>
  <priority>0.70</priority>
</url>
<url>
  <loc>{{ site.url }}/contact</loc>
  <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  <changefreq>monthly</changefreq>
  <priority>0.50</priority>
</url>

<!-- ===== الأدوات ===== -->
{% for tool in site.data.tools %}
<url>
  <loc>{{ tool.url | absolute_url }}</loc>
  <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  <changefreq>monthly</changefreq>
  <priority>0.80</priority>
</url>
{% endfor %}

<!-- ===== المقررات ===== -->
{% for p in site.pages %}
{% if p.layout == 'course' and p.code %}
<url>
  <loc>{{ p.url | absolute_url }}</loc>
  {% if p.date %}<lastmod>{{ p.date | date_to_xmlschema }}</lastmod>{% else %}<lastmod>{{ site.time | date_to_xmlschema }}</lastmod>{% endif %}
  <changefreq>weekly</changefreq>
  <priority>0.70</priority>
</url>
{% endif %}
{% endfor %}

<!-- ===== المقالات ===== -->
{% for post in site.posts %}
{% if post.visible != false %}
<url>
  <loc>{{ post.url | absolute_url }}</loc>
  {% if post.date %}<lastmod>{{ post.date | date_to_xmlschema }}</lastmod>{% else %}<lastmod>{{ site.time | date_to_xmlschema }}</lastmod>{% endif %}
  <changefreq>monthly</changefreq>
  <priority>0.60</priority>
</url>
{% endif %}
{% endfor %}

</urlset>